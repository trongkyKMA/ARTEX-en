# Docker deployment settings (copy to .env)
# Version label shown on the settings page; the image itself is built from this checkout.
ARTEX_BUILD_VERSION=dev
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex

# LLM (fill one or both; or leave empty and configure it in the UI)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=

# Address the web UI/API listens on. Default 127.0.0.1 (localhost only): reach it through an
# SSH tunnel (ssh -L 8787:127.0.0.1:8787 user@server) or a TLS reverse proxy. 0.0.0.0 exposes it
# on every interface - only do that behind a firewall that limits who can connect.
ARTEX_BIND=127.0.0.1
