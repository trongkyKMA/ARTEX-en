# Docker deployment settings (copy to .env)
# Version label shown on the settings page; the image itself is built from this checkout.
ARTEX_BUILD_VERSION=dev
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex

# LLM (fill one or both; or leave empty and configure it in the UI)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=
